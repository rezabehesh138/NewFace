    /*
       کد را String نگه می‌داریم
       تا صفرهای اول مثل 0125
       حذف نشوند.
    */

    code =
        String(code);


    showToast(
        "در حال جستجو..."
    );


    const result =
        await db
        .from(TABLE_NAME)
        .select(
            "code,name,price,previous_price"
        )
        .eq(
            "code",
            code
        )
        .maybeSingle();


    if(result.error){

        console.error(
            result.error
        );


        showNotFound(
            "خطای Supabase: " +
            result.error.message
        );


        setConnection(
            "خطای دیتابیس",
