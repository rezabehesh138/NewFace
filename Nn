/* =========================================================
   OPEN SCANNER
========================================================= */

async function openScanner(){

    if(scannerStarting)
        return;


    scannerStarting =
        true;


    document
    .getElementById(
        "scannerModal"
    )
    .style.display =
    "block";


    document
    .getElementById(
        "cameraError"
    )
    .style.display =
    "none";


    /*
       اول بررسی می‌کنیم
       مرورگر اصلاً getUserMedia
       دارد یا نه.
    */

    if(
        !navigator.mediaDevices ||
        !navigator.mediaDevices.getUserMedia
    ){

        showCameraError(
            "مرورگر این دستگاه دسترسی مستقیم به دوربین را پشتیبانی نمی‌کند."
        );


        scannerStarting =
        false;


        return;
    }


    try{

        /*
           یک بار درخواست دسترسی
           به دوربین می‌کنیم.

           این کار باعث می‌شود
           permission مرورگر مشخص شود.
        */

        const stream =
            await navigator.mediaDevices
            .getUserMedia({

                video:{
                    facingMode:{
                        ideal:"environment"
                    }
                },

                audio:false

            });


        /*
           فقط برای تست permission بود.
           بلافاصله stream را می‌بندیم.
        */

        stream
        .getTracks()
        .forEach(
            track =>
            track.stop()
        );


    }catch(error){

        console.error(
            "CAMERA PERMISSION ERROR:",
            error
        );


        showCameraError(
            cameraErrorMessage(
                error
            )
        );


        scannerStarting =
        false;


        return;
    }


    /*
       حالا Scanner را اجرا می‌کنیم.
    */

    try{

        scanner =
            new Html5Qrcode(
                "reader"
            );


        const config = {

            fps:10,

            qrbox:{
                width:300,
                height:140
            },

            aspectRatio:
                window.innerWidth /
                window.innerHeight,

            formatsToSupport:[

                Html5QrcodeSupportedFormats.CODE_128,

                Html5QrcodeSupportedFormats.CODE_39,

                Html5QrcodeSupportedFormats.CODE_93,

                Html5QrcodeSupportedFormats.EAN_13,

                Html5QrcodeSupportedFormats.EAN_8,

                Html5QrcodeSupportedFormats.ITF,

                Html5QrcodeSupportedFormats.UPC_A,

                Html5QrcodeSupportedFormats.UPC_E

            ]

        };


        /*
           تلاش اول:
           دوربین پشت
        */

        await scanner.start(

            {
                facingMode:{
                    ideal:"environment"
                }
            },

            config,

            onBarcodeSuccess,

            function(){}

        );


        scannerStarting =
        false;


    }catch(firstError){

        console.error(
            "FIRST CAMERA START ERROR:",
            firstError
        );


        /*
           اگر روش اول جواب نداد،
           دوربین‌های دستگاه را
           پیدا می‌کنیم.
        */

        try{

            const cameras =
                await Html5Qrcode
                .getCameras();


            if(
                !cameras ||
                cameras.length === 0
            ){

                throw new Error(
                    "هیچ دوربینی توسط مرورگر شناسایی نشد."
                );

            }


            /*
               اول دوربین‌هایی که
               اسمشان back/rear دارد.
            */

            let selectedCamera =
                cameras.find(
                    camera =>
                    /back|rear|environment/i
                    .test(
                        camera.label
                    )
                );


            /*
               اگر پیدا نشد،
               آخرین دوربین را امتحان می‌کنیم.
            */

            if(!selectedCamera){

                selectedCamera =
                    cameras[
                        cameras.length - 1
                    ];

            }


            const config = {

                fps:10,

                qrbox:{
                    width:300,
                    height:140
                },

                formatsToSupport:[

                    Html5QrcodeSupportedFormats.CODE_128,

                    Html5QrcodeSupportedFormats.CODE_39,

                    Html5QrcodeSupportedFormats.CODE_93,

                    Html5QrcodeSupportedFormats.EAN_13,

                    Html5QrcodeSupportedFormats.EAN_8,

                    Html5QrcodeSupportedFormats.ITF,

                    Html5QrcodeSupportedFormats.UPC_A,

                    Html5QrcodeSupportedFormats.UPC_E

                ]

            };


            await scanner.start(

                selectedCamera.id,

                config,

                onBarcodeSuccess,

                function(){}

            );


            scannerStarting =
            false;


        }catch(secondError){

            console.error(
                "SECOND CAMERA START ERROR:",
                secondError
            );


            showCameraError(
                cameraErrorMessage(
                    secondError
                )
            );


            scannerStarting =
            false;

        }

    }

}


/* =========================================================
   CAMERA ERROR MESSAGE
========================================================= */

function cameraErrorMessage(
    error
){

    const name =
        error &&
        error.name
        ? error.name
        : "";


    const message =
        error &&
        error.message
        ? error.message
        : "";


    if(
        name ===
        "NotAllowedError"
    ){

        return `
        اجازه استفاده از دوربین رد شده است.<br><br>
        از تنظیمات مرورگر، دسترسی Camera
        برای این سایت را روی Allow قرار دهید.
        `;

    }


    if(
        name ===
        "NotFoundError"
    ){

        return `
        هیچ دوربین قابل استفاده‌ای پیدا نشد.
        `;

    }


    if(
        name ===
        "NotReadableError"
    ){

        return `
        دوربین توسط برنامه دیگری در حال استفاده است.
        برنامه‌هایی که از دوربین استفاده می‌کنند را ببندید و دوباره امتحان کنید.
        `;

    }


    if(
        name ===
        "SecurityError"
    ){

        return `
        مرورگر دسترسی دوربین را به دلیل تنظیمات امنیتی مسدود کرده است.
        مطمئن شوید صفحه با HTTPS باز شده است.
        `;

    }


    if(
        name ===
        "OverconstrainedError"
    ){

        return `
        تنظیمات دوربین انتخاب‌شده توسط دستگاه پشتیبانی نمی‌شود.
        `;

    }


    return `
        خطای دوربین:<br>
        ${message || "دوربین راه‌اندازی نشد."}
        <br><br>
        کد خطا:
        ${name || "Unknown"}
    `;

}


