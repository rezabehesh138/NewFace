/* =========================================================
   EXCEL READER
========================================================= */

async function readExcel(event){

    const file =
        event.target.files[0];


    if(!file)
        return;


    showToast(
        "در حال خواندن Excel..."
    );


    try{

        const buffer =
            await file.arrayBuffer();


        const workbook =
            XLSX.read(
                buffer,
                {
                    type:"array",
                    raw:false
                }
            );


        const sheet =
            workbook.Sheets[
                workbook.SheetNames[0]
            ];


        const rows =
            XLSX.utils.sheet_to_json(
                sheet,
                {
                    defval:"",
                    raw:false
                }
            );


        importedProducts = [];


        for(
            const row
            of rows
        ){

            /*
               ستون اول:
               بارکد
            */

            let barcode =
                row["بارکد"] ??
                row["بارکد کالا"] ??
                row["کد"] ??
                row["کد کالا"] ??
                "";


            /*
               ستون دوم:
               نام کالا
            */

            let name =
                row["نام کالا"] ??
                row["نام"] ??
                "";


            /*
               ستون سوم:
               فروش نقدی = قیمت
            */

            let price =
                row["فروش نقدی"] ??
                row["قیمت"] ??
                "";


            barcode =
                normalizeBarcode(
                    barcode
                );


            name =
                String(
                    name
                ).trim();


            price =
                normalizeNumber(
                    price
                );


            /*
               ردیف ناقص حذف می‌شود.
            */

            if(
                !barcode ||
                !name
            ){

                continue;

            }


            importedProducts.push({

                code:
                    barcode,

                name:
                    name,

                price:
                    price

            });

        }


        /*
           حذف بارکدهای تکراری
        */

        const unique =
            new Map();


        importedProducts.forEach(
            item => {

                unique.set(
                    item.code,
                    item
                );

            }
        );


        importedProducts =
            Array.from(
                unique.values()
            );


        if(
            !importedProducts.length
        ){

            showToast(
                "ستون‌های بارکد و نام کالا پیدا نشد."
            );

            return;

        }


        await analyzeExcel();


    }catch(error){

        console.error(
            "EXCEL ERROR:",
            error
        );


        showToast(
            "خطا در خواندن فایل Excel."
        );

    }

}


/* =========================================================
   NORMALIZE BARCODE
========================================================= */

function normalizeBarcode(
    value
){

    if(
        value ===
        null ||
        value ===
        undefined
    ){

        return "";

    }


    /*
       حذف .0 که Excel گاهی
       به انتهای عدد اضافه می‌کند.
    */

    let text =
        String(
            value
        )
        .trim();


    if(
        text.endsWith(".0")
    ){

        text =
            text.slice(
                0,
                -2
            );

    }


    return text;

}


/* =========================================================
   NORMALIZE NUMBER
========================================================= */

function normalizeNumber(
    value
){

    if(
        value ===
        null ||
        value ===
        undefined
    ){

        return 0;

    }


    let text =
        String(
            value
        );


    /*
       اعداد فارسی
       به انگلیسی
    */

    const persian =
        "۰۱۲۳۴۵۶۷۸۹";


    const arabic =
        "٠١٢٣٤٥٦٧٨٩";


    for(
        let i=0;
        i<10;
        i++
    ){

        text =
            text.replace(
                new RegExp(
                    persian[i],
                    "g"
                ),
                String(i)
            );


        text =
            text.replace(
                new RegExp(
                    arabic[i],
                    "g"
                ),
                String(i)
            );

    }


    /*
       حذف کاما و جداکننده
    */

    text =
        text.replace(
            /,/g,
            ""
        );


    text =
        text.replace(
            /[^\d.-]/g,
            ""
        );


    const number =
        Number(
            text
        );


    return Number.isFinite(
        number
    )
    ? number
    : 0;

}


/* =========================================================
   ANALYZE EXCEL
========================================================= */

async function analyzeExcel(){

    const codes =
        importedProducts.map(
            item =>
            item.code
        );


    let existingProducts = [];


    const batchSize =
        500;


    for(
        let i=0;
        i<codes.length;
        i+=batchSize
    ){

        const batch =
            codes.slice(
                i,
                i+batchSize
            );


        const result =
            await db
            .from(TABLE_NAME)
            .select(
                "code,name,price"
            )
            .in(
                "code",
                batch
            );


        if(result.error){

            console.error(
                result.error
            );


            showToast(
                "خطای دیتابیس: " +
                result.error.message
            );


            return;

        }


        existingProducts.push(
            ...(result.data || [])
        );

    }


    const existing =
        new Map();


    existingProducts.forEach(
        item => {

            existing.set(
                String(item.code),
                item
            );

        }
    );


    let newCount = 0;

    let priceChanged = 0;

    let unchanged = 0;


    importedProducts.forEach(
        item => {

            const old =
                existing.get(
                    item.code
                );


            if(!old){

                newCount++;

            }
            else if(
                Number(old.price || 0) !==
                Number(item.price || 0)
            ){

                priceChanged++;

            }
            else{

                unchanged++;

            }

        }
    );


    document
    .getElementById(
        "totalRows"
    )
    .innerText =
    importedProducts.length;


    document
    .getElementById(
        "newRows"
    )
    .innerText =
    newCount;


    document
    .getElementById(
        "priceChangedRows"
    )
    .innerText =
    priceChanged;


    document
    .getElementById(
        "unchangedRows"
    )
    .innerText =
    unchanged;


    document
    .getElementById(
        "importResult"
    )
    .style.display =
    "block";


    showToast(
        "فایل آماده ورود است."
    );

}


/* =========================================================
   APPLY EXCEL
========================================================= */

async function applyImport(){

    if(
        !importedProducts.length
    )
        return;


    const ok =
        confirm(
            "اطلاعات Excel وارد دیتابیس شود؟\n\nقیمت‌های قبلی محصولات قبل از تغییر ذخیره می‌شوند."
        );


    if(!ok)
        return;


    showToast(
        "در حال بروزرسانی..."
    );


    /*
       اول محصولات موجود را
       می‌خوانیم تا قیمت قبلی
       را از دست ندهیم.
    */

    const codes =
        importedProducts.map(
            item =>
            item.code
        );


    let existingProducts = [];


    const batchSize =
        500;


    for(
        let i=0;
        i<codes.length;
        i+=batchSize
    ){

        const batch =
            codes.slice(
                i,
                i+batchSize
            );


        const result =
            await db
            .from(TABLE_NAME)
            .select(
                "code,name,price,previous_price"
            )
            .in(
                "code",
                batch
            );


        if(result.error){

            showToast(
                "خطا: " +
                result.error.message
            );

            return;

        }


        existingProducts.push(
            ...(result.data || [])
        );

    }


    const existing =
        new Map();


    existingProducts.forEach(
        item => {

            existing.set(
                String(item.code),
                item
            );

        }
    );


    /*
       برای هر محصول:

       اگر جدید است:
       previous_price = null

       اگر موجود است و قیمت تغییر کرده:
       previous_price = قیمت فعلی
       price = قیمت جدید
    */

    const rows =
        importedProducts.map(
            item => {

                const old =
                    existing.get(
                        item.code
                    );


                if(!old){

                    return {

                        code:
                            item.code,

                        name:
                            item.name,

                        price:
                            item.price,

                        previous_price:
                            null

                    };

                }


                const oldPrice =
                    Number(
                        old.price || 0
                    );


                const newPrice =
                    Number(
                        item.price || 0
                    );


                return {

                    code:
                        item.code,

                    name:
                        item.name,

                    price:
                        newPrice,

                    previous_price:
                        oldPrice !== newPrice
                        ? oldPrice
                        : old.previous_price

                };

            }
        );


    /*
       ورود به صورت batch
    */

    for(
        let i=0;
        i<rows.length;
        i+=batchSize
    ){

        const batch =
            rows.slice(
                i,
                i+batchSize
            );


        const result =
            await db
            .from(TABLE_NAME)
            .upsert(
                batch,
                {
                    onConflict:
                        "code"
                }
            );


        if(result.error){

            console.error(
                result.error
            );


            showToast(
                "خطا در ورود Excel: " +
                result.error.message
            );


            return;

        }

    }


    importedProducts = [];


    document
    .getElementById(
        "importResult"
    )
    .style.display =
    "none";


    document
    .getElementById(
        "excelFile"
    )
    .value =
    "";


    showToast(
        "اطلاعات با موفقیت بروزرسانی شد."
    );


    testConnection();

}


