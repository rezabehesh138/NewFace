<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>نیوفیس | قیمت محصولات</title>


<!-- ================= SUPABASE ================= -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<!-- ================= BARCODE SCANNER ================= -->

<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>


<!-- ================= EXCEL ================= -->

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>


<!-- ================= FONT ================= -->

<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">


<style>

/* =========================================================
   VARIABLES
========================================================= */

:root{

    --pink:#CC3A63;

    --pink-dark:#A82C50;

    --pink-light:#FCE9EF;

    --bg:#F6F6F8;

    --card:#FFFFFF;

    --text:#202124;

    --muted:#777;

    --border:#E6E6EA;

    --green:#15966A;

    --red:#D43B3B;

}


/* =========================================================
   GENERAL
========================================================= */

*{

    box-sizing:border-box;

    -webkit-tap-highlight-color:transparent;

}


body{

    margin:0;

    background:var(--bg);

    color:var(--text);

    font-family:"Vazirmatn",sans-serif;

}


button,
input{

    font-family:inherit;

}


.app{

    width:100%;

    max-width:540px;

    min-height:100vh;

    margin:auto;

}


/* =========================================================
   HEADER
========================================================= */

.header{

    background:
        linear-gradient(
            135deg,
            #CC3A63,
            #B42D53
        );

    color:#fff;

    padding:24px 18px 28px;

    border-radius:
        0
        0
        28px
        28px;

    box-shadow:
        0 10px 30px
        rgba(204,58,99,.22);

}


.header-top{

    display:flex;

    justify-content:space-between;

    align-items:center;

}


.logo{

    font-size:27px;

    font-weight:800;

}


.subtitle{

    font-size:10px;

    opacity:.85;

    margin-top:3px;

}


/* =========================================================
   CONNECTION STATUS
========================================================= */

.connection{

    display:flex;

    align-items:center;

    gap:7px;

    padding:
        7px
        11px;

    border-radius:30px;

    background:
        rgba(255,255,255,.14);

    font-size:10px;

}


.connection-dot{

    width:8px;

    height:8px;

    border-radius:50%;

    background:#FFD65A;

}


.connection.connected .connection-dot{

    background:#65F5A2;

}


.connection.error .connection-dot{

    background:#FF7777;

}


/* =========================================================
   SEARCH
========================================================= */

.search-box{

    margin-top:22px;

    background:#fff;

    border-radius:16px;

    padding:5px;

    display:flex;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.12);

}


.search-input{

    flex:1;

    min-width:0;

    border:0;

    outline:none;

    padding:12px;

    font-size:14px;

    direction:ltr;

    text-align:right;

}


.search-input::placeholder{

    direction:rtl;

    color:#999;

}


.search-btn{

    width:45px;

    height:45px;

    border:0;

    border-radius:12px;

    background:var(--pink);

    color:#fff;

    font-size:19px;

}


/* =========================================================
   CONTENT
========================================================= */

.content{

    padding:
        20px
        15px
        40px;

}


.section-title{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin:
        5px
        3px
        10px;

}


.section-title h2{

    margin:0;

    font-size:15px;

}


.section-title span{

    color:var(--muted);

    font-size:10px;

}


/* =========================================================
   CARD
========================================================= */

.card{

    background:#fff;

    border:
        1px
        solid
        var(--border);

    border-radius:20px;

    padding:16px;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.05);

}


/* =========================================================
   SCAN BUTTON
========================================================= */

.scan-btn{

    width:100%;

    height:62px;

    border:0;

    border-radius:16px;

    background:var(--pink);

    color:#fff;

    font-size:15px;

    font-weight:700;

}


.scan-btn:active{

    transform:scale(.98);

}


.scan-description{

    text-align:center;

    color:var(--muted);

    font-size:10px;

    margin-top:10px;

}


/* =========================================================
   PRODUCT
========================================================= */

.product{

    display:none;

    margin-top:18px;

    background:#fff;

    border:
        1px
        solid
        var(--border);

    border-radius:20px;

    overflow:hidden;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.05);

}


.product-main{

    padding:20px;

}


.code{

    display:inline-block;

    padding:
        5px
        11px;

    border-radius:20px;

    background:var(--pink-light);

    color:var(--pink-dark);

    font-size:10px;

    font-weight:700;

}


.product-name{

    margin:
        12px
        0
        18px;

    font-size:18px;

    line-height:1.8;

    font-weight:800;

}


.price-label{

    color:var(--muted);

    font-size:10px;

}


.price{

    color:var(--pink);

    font-size:30px;

    font-weight:800;

    margin-top:2px;

}


.toman{

    color:var(--muted);

    font-size:11px;

    font-weight:500;

}


/* =========================================================
   ACTIONS
========================================================= */

.actions{

    display:grid;

    grid-template-columns:
        1fr
        1fr;

    gap:9px;

    padding:
        0
        20px
        20px;

}


.action{

    min-height:48px;

    border:
        1px
        solid
        var(--border);

    border-radius:13px;

    background:#fff;

    font-size:11px;

    font-weight:600;

}


.action.primary{

    border:0;

    background:var(--pink-light);

    color:var(--pink-dark);

}


/* =========================================================
   PREVIOUS PRICE
========================================================= */

.previous{

    display:none;

    margin:
        0
        20px
        18px;

    padding:13px;

    border-radius:12px;

    background:#F7F7F8;

    color:var(--muted);

    font-size:11px;

}


.previous strong{

    color:var(--text);

}


/* =========================================================
   EDIT
========================================================= */

.edit{

    display:none;

    margin:
        0
        20px
        18px;

    padding:15px;

    border-radius:15px;

    background:var(--pink-light);

}


.edit label{

    display:block;

    color:var(--pink-dark);

    font-size:10px;

    margin-bottom:7px;

}


.price-input{

    width:100%;

    height:48px;

    border:
        1px
        solid
        #E2A7B8;

    border-radius:12px;

    outline:none;

    background:#fff;

    padding:0 13px;

    font-size:15px;

    direction:ltr;

    text-align:right;

}


.save-btn{

    width:100%;

    height:46px;

    margin-top:9px;

    border:0;

    border-radius:12px;

    background:var(--pink);

    color:#fff;

    font-weight:700;

}


/* =========================================================
   NOT FOUND
========================================================= */

.not-found{

    display:none;

    text-align:center;

    padding:30px 10px;

    color:var(--muted);

}


.not-found-icon{

    font-size:35px;

}


.not-found-title{

    color:var(--text);

    font-weight:700;

    font-size:14px;

    margin-top:5px;

}


/* =========================================================
   EXCEL
========================================================= */

.excel-section{

    margin-top:23px;

}


.excel-btn{

    width:100%;

    min-height:55px;

    border:
        1px
        dashed
        #D2D2D7;

    border-radius:14px;

    background:#FAFAFB;

    font-size:12px;

    font-weight:700;

}


.excel-info{

    margin-top:10px;

    padding:11px;

    border-radius:12px;

    background:var(--pink-light);

    color:var(--pink-dark);

    font-size:10px;

    line-height:2;

}


#excelFile{

    display:none;

}


/* =========================================================
   IMPORT RESULT
========================================================= */

.import-result{

    display:none;

    margin-top:14px;

    background:#fff;

    border:
        1px
        solid
        var(--border);

    border-radius:20px;

    padding:17px;

    box-shadow:
        0 8px 25px
        rgba(0,0,0,.05);

}


.import-result h3{

    margin:
        0
        0
        14px;

    font-size:14px;

}


.stats{

    display:grid;

    grid-template-columns:
        1fr
        1fr;

    gap:8px;

}


.stat{

    background:#F7F7F8;

    border-radius:12px;

    padding:12px;

    text-align:center;

}


.stat-number{

    display:block;

    color:var(--pink);

    font-size:18px;

    font-weight:800;

}


.stat-label{

    color:var(--muted);

    font-size:9px;

}


.import-actions{

    display:grid;

    grid-template-columns:
        1fr
        1fr;

    gap:8px;

    margin-top:14px;

}


.import-action{

    height:46px;

    border:0;

    border-radius:12px;

    font-size:11px;

    font-weight:700;

}


.cancel{

    background:#EFEFF1;

}


.confirm{

    background:var(--pink);

    color:#fff;

}


/* =========================================================
   SCANNER
========================================================= */

.scanner-modal{

    display:none;

    position:fixed;

    inset:0;

    background:#000;

    z-index:9999;

}


.scanner-header{

    position:absolute;

    top:0;

    left:0;

    right:0;

    height:70px;

    padding:
        0
        17px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    color:#fff;

    z-index:10;

    background:
        linear-gradient(
            rgba(0,0,0,.5),
            transparent
        );

}


.close-scanner{

    width:42px;

    height:42px;

    border:0;

    border-radius:50%;

    background:
        rgba(255,255,255,.15);

    color:#fff;

    font-size:25px;

}


#reader{

    width:100%;

    height:100%;

}


#reader video{

    width:100% !important;

    height:100% !important;

    object-fit:cover !important;

}


#reader__dashboard{

    display:none !important;

}


#reader__scan_region{

    width:100% !important;

    height:100% !important;

}


#reader__scan_region img{

    display:none !important;

}


.scanner-help{

    position:absolute;

    left:20px;

    right:20px;

    bottom:25px;

    color:#fff;

    text-align:center;

    font-size:11px;

    z-index:10;

}


/* =========================================================
   CAMERA ERROR
========================================================= */

.camera-error{

    display:none;

    position:absolute;

    left:20px;

    right:20px;

    top:50%;

    transform:translateY(-50%);

    background:#fff;

    border-radius:20px;

    padding:20px;

    z-index:20;

    color:#222;

    text-align:center;

}


.camera-error-title{

    font-size:15px;

    font-weight:800;

    margin-bottom:10px;

}


.camera-error-text{

    font-size:11px;

    line-height:2;

    color:#666;

}


.camera-retry{

    width:100%;

    height:45px;

    border:0;

    border-radius:12px;

    background:var(--pink);

    color:#fff;

    margin-top:15px;

    font-weight:700;

}


/* =========================================================
   TOAST
========================================================= */

.toast{

    position:fixed;

    left:15px;

    right:15px;

    bottom:18px;

    padding:13px;

    border-radius:14px;

    background:#222;

    color:#fff;

    text-align:center;

    font-size:11px;

    z-index:20000;

    transform:
        translateY(100px);

    opacity:0;

    transition:.3s;

}


.toast.show{

    transform:
        translateY(0);

    opacity:1;

}


/* =========================================================
   DESKTOP
========================================================= */

@media(min-width:600px){

    body{

        padding:20px 0;

    }


    .app{

        min-height:
            calc(100vh - 40px);

        border-radius:28px;

        overflow:hidden;

        box-shadow:
            0 20px 60px
            rgba(0,0,0,.08);

    }

}

</style>

</head>


<body>


<div class="app">


<!-- =====================================================
     HEADER
===================================================== -->

<header class="header">


    <div class="header-top">


        <div>

            <div class="logo">
                نیوفیس
            </div>

            <div class="subtitle">
                استعلام سریع قیمت محصولات
            </div>

        </div>


        <!-- CONNECTION -->

        <div
            id="connection"
            class="connection">

            <span
                id="connectionDot"
                class="connection-dot">
            </span>

            <span
                id="connectionText">
                در حال بررسی...
            </span>

        </div>


    </div>


    <!-- SEARCH -->

    <div class="search-box">


        <input
            id="searchInput"
            class="search-input"
            type="text"
            inputmode="text"
            autocomplete="off"
            placeholder="کد کالا یا بارکد...">


        <button
            class="search-btn"
            onclick="searchProduct()">

            🔎

        </button>


    </div>


</header>


<!-- =====================================================
     CONTENT
===================================================== -->

<main class="content">


<!-- PRODUCT SEARCH -->

<div class="section-title">

    <h2>
        استعلام محصول
    </h2>

    <span>
        بارکدخوان
    </span>

</div>


<div class="card">


    <button
        class="scan-btn"
        onclick="openScanner()">

        📷 &nbsp;
        اسکن بارکد محصول

    </button>


    <div class="scan-description">

        دوربین را مقابل بارکد محصول قرار دهید

    </div>


</div>


<!-- PRODUCT -->

<div
    id="product"
    class="product">


    <div class="product-main">


        <div
            id="productCode"
            class="code">
        </div>


        <div
            id="productName"
            class="product-name">
        </div>


        <div class="price-label">
            قیمت فعلی
        </div>


        <div class="price">

            <span
                id="productPrice">
            </span>

            <span class="toman">
                تومان
            </span>

        </div>


    </div>


    <!-- PREVIOUS PRICE -->

    <div
        id="previous"
        class="previous">

        قیمت قبلی:

        <strong
            id="previousPrice">
        </strong>

        تومان

    </div>


    <!-- EDIT -->

    <div
        id="edit"
        class="edit">


        <label>
            قیمت جدید
        </label>


        <input
            id="newPrice"
            class="price-input"
            type="text"
            inputmode="numeric"
            placeholder="مثلاً 3500000">


        <button
            class="save-btn"
            onclick="savePrice()">

            ذخیره قیمت

        </button>


    </div>


    <!-- ACTIONS -->

    <div class="actions">


        <button
            class="action primary"
            onclick="toggleEdit()">

            ✎ ویرایش قیمت

        </button>


        <button
            class="action"
            onclick="togglePrevious()">

            ◷ قیمت قبلی

        </button>


    </div>


</div>


<!-- NOT FOUND -->

<div
    id="notFound"
    class="not-found">


    <div class="not-found-icon">
        🔍
    </div>


    <div class="not-found-title">
        محصول پیدا نشد
    </div>


    <div id="notFoundText">
        این کد در دیتابیس وجود ندارد.
    </div>


</div>


<!-- EXCEL -->

<div class="excel-section">


    <div class="section-title">


        <h2>
            بروزرسانی محصولات
        </h2>


        <span>
            Excel
        </span>


    </div>


    <div class="card">


        <button
            class="excel-btn"
            onclick="document.getElementById('excelFile').click()">

            📊 &nbsp;
            انتخاب فایل Excel انبار محک

        </button>


        <div class="excel-info">

            فایل Excel باید دقیقاً شامل این سه ستون باشد:

            <br>

            <b>بارکد</b>
            &nbsp; | &nbsp;
            <b>نام کالا</b>
            &nbsp; | &nbsp;
            <b>فروش نقدی</b>

            <br>

            «فروش نقدی» به‌عنوان قیمت محصول ذخیره می‌شود.

        </div>


        <input
            id="excelFile"
            type="file"
            accept=".xlsx,.xls,.csv"
            onchange="readExcel(event)">


    </div>


</div>


<!-- IMPORT RESULT -->

<div
    id="importResult"
    class="import-result">


    <h3>
        نتیجه بررسی فایل
    </h3>


    <div class="stats">


        <div class="stat">

            <span
                id="totalRows"
                class="stat-number">
                0
            </span>

            <span class="stat-label">
                کل محصولات
            </span>

        </div>


        <div class="stat">

            <span
                id="newRows"
                class="stat-number">
                0
            </span>

            <span class="stat-label">
                محصول جدید
            </span>

        </div>


        <div class="stat">

            <span
                id="priceChangedRows"
                class="stat-number">
                0
            </span>

            <span class="stat-label">
                قیمت تغییر کرده
            </span>

        </div>


        <div class="stat">

            <span
                id="unchangedRows"
                class="stat-number">
                0
            </span>

            <span class="stat-label">
                بدون تغییر
            </span>

        </div>


    </div>


    <div class="import-actions">


        <button
            class="import-action cancel"
            onclick="cancelImport()">

            لغو

        </button>


        <button
            class="import-action confirm"
            onclick="applyImport()">

            اعمال اطلاعات

        </button>


    </div>


</div>


</main>

</div>


<!-- =====================================================
     SCANNER
===================================================== -->

<div
    id="scannerModal"
    class="scanner-modal">


    <div class="scanner-header">


        <strong>
            اسکن بارکد
        </strong>


        <button
            class="close-scanner"
            onclick="closeScanner()">

            ×

        </button>


    </div>


    <div id="reader"></div>


    <div
        id="cameraError"
        class="camera-error">


        <div class="camera-error-title">
            دوربین باز نشد
        </div>


        <div
            id="cameraErrorText"
            class="camera-error-text">

        </div>


        <button
            class="camera-retry"
            onclick="retryCamera()">

            تلاش دوباره

        </button>


    </div>


    <div class="scanner-help">

        بارکد را داخل محدوده دوربین قرار دهید

    </div>


</div>


<!-- TOAST -->

<div
    id="toast"
    class="toast">
</div>


<script>


/* =========================================================
   SUPABASE CONFIG
   فقط این قسمت را تغییر بده
========================================================= */


/*
   آدرس پروژه Supabase
*/

const SUPABASE_URL =
    "YOUR_SUPABASE_URL";


/*
   Publishable key / anon key
*/

const SUPABASE_KEY =
    "YOUR_SUPABASE_PUBLISHABLE_KEY";


/*
   نام جدول Supabase

   اگر جدول تو products نیست،
   فقط همین مقدار را تغییر بده.

   مثال:

   const TABLE_NAME = "product";

*/

const TABLE_NAME =
    "products";


/* =========================================================
   SUPABASE CLIENT
========================================================= */

const db =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY
    );


/* =========================================================
   VARIABLES
========================================================= */

let currentProduct = null;

let scanner = null;

let importedProducts = [];

let scannerStarting = false;


/* =========================================================
   CONNECTION TEST
========================================================= */

async function testConnection(){

    setConnection(
        "در حال بررسی...",
        "loading"
    );


    try{

        /*
           فقط یک رکورد می‌خوانیم.
           هدف فقط تست اتصال و وجود جدول است.
        */

        const result =
            await db
            .from(TABLE_NAME)
            .select("code")
            .limit(1);


        if(result.error){

            console.error(
                "SUPABASE ERROR:",
                result.error
            );


            setConnection(
                "خطای دیتابیس",
                "error"
            );


            /*
               نمایش خطای دقیق
            */

            showToast(
                "Supabase: " +
                result.error.message
            );


            return false;
        }


        setConnection(
            "متصل",
            "connected"
        );


        return true;


    }catch(error){

        console.error(error);


        setConnection(
            "قطع",
            "error"
        );


        showToast(
            "خطا در اتصال به دیتابیس"
        );


        return false;
    }
}


/* =========================================================
   CONNECTION UI
========================================================= */

function setConnection(
    text,
    state
){

    const box =
        document
        .getElementById(
            "connection"
        );


    const textElement =
        document
        .getElementById(
            "connectionText"
        );


    textElement.innerText =
        text;


    box.classList.remove(
        "connected",
        "error"
    );


    if(state === "connected"){

        box.classList.add(
            "connected"
        );

    }


    if(state === "error"){

        box.classList.add(
            "error"
        );

    }

}


/* =========================================================
   SEARCH PRODUCT
========================================================= */

async function searchProduct(){

    let code =
        document
        .getElementById(
            "searchInput"
        )
        .value
        .trim();


    if(!code){

        showToast(
